<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="arca_service_status_production" model="l10n_ar.afip.service.status">
        <field name="environment">production</field>
    </record>
    <record id="arca_service_status_testing" model="l10n_ar.afip.service.status">
        <field name="environment">testing</field>
    </record>
    <record id="ir_cron_arca_service_status" model="ir.cron">
        <field name="name">ARCA: Check service availability</field>
        <field name="model_id" ref="model_l10n_ar_afip_service_status"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_status()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
